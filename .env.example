# org-python-platform local environment
# Copy to .env:  cp .env.example .env   (or: make env-init)
#
# Load in Python:  from scripts.from_env import load_dotenv_file; load_dotenv_file()
# Or use:         python -c "from scripts.from_env import llm_gateway_settings; print(llm_gateway_settings())"

# -----------------------------------------------------------------------------
# LiteLLM gateway (packages/litellm_gateway)
# -----------------------------------------------------------------------------
AGENT_MOCK_LLM=true
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=
# LLM_PROVIDERS=groq:llama-3.3-70b-versatile,openai:gpt-4o-mini
# LLM_PROXY_URL=
# LLM_PROXY_API_KEY=
LLM_CACHE_ENABLED=true
LLM_RATE_LIMIT_ENABLED=false
LLM_RATE_LIMIT_WINDOW_SECONDS=60
LLM_RATE_LIMIT_MAX=60
LLM_MAX_PROMPT_CHARS=32000
LLM_MAX_TOKENS_CAP=4096
DEPLOYMENT_PREFIX=app

# Provider API keys (set at least one when AGENT_MOCK_LLM=false)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TOGETHER_API_KEY=
# HF_TOKEN=
# AZURE_API_KEY=
# AZURE_API_BASE=

# -----------------------------------------------------------------------------
# Langfuse tracing (packages/langfuse_tracing)
# -----------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# FastAPI platform / JWT (packages/fastapi_platform)
# -----------------------------------------------------------------------------
# APP_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Publish / GitHub Packages (make publish, make upload)
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=
TWINE_USERNAME=__token__
# TWINE_PASSWORD=          # usually same as GITHUB_TOKEN
# TWINE_REPOSITORY_URL=https://upload.pypi.pkg.github.com/tusharwagh/
